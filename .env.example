# Public browser-safe Supabase settings. Never add privileged credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Add this only to the hosting provider's encrypted environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical application origin used in authentication emails.
APP_URL=https://alupc-attendance.vercel.app

# Optional fictional local seed data. Keep false in production.
NEXT_PUBLIC_ENABLE_DEMO_SEED=false
